# Copie para .env e ajuste. NUNCA commite o .env.
# Em produção estes valores ficam no servidor (deploy/.env), fora do repositório.

# --- Banco de dados (APENAS desenvolvimento; em produção use uma senha forte) ---
POSTGRES_DB=bellabiel
POSTGRES_USER=bellabiel
POSTGRES_PASSWORD=bellabiel_dev
DB_URL=jdbc:postgresql://localhost:5432/bellabiel
DB_USER=bellabiel
DB_PASSWORD=bellabiel_dev

# --- Backend ---
# Perfis: dev | test | prod. Sem perfil = comportamento de produção (sem seed, sem Swagger).
SPRING_PROFILES_ACTIVE=dev
# Origens permitidas por CORS, separadas por vírgula. Vazio = nenhuma (produção usa o mesmo domínio).
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Fase 1.A (autenticação) — documentados desde já ---
# Segredo do JWT (>= 32 bytes aleatórios): openssl rand -base64 48
APP_JWT_SECRET=
# Primeiro ADMIN (criado só se não existir nenhum). Troca de senha obrigatória no primeiro acesso.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# --- Produção (Fase 1.F) ---
APP_DOMAIN=bellabiel.example.com
